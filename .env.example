# Copie para .env e ajuste. Nunca commite o .env.
POSTGRES_USER=zela
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=zela
DATABASE_URL=postgresql+psycopg://zela:troque-esta-senha@db:5432/zela

# Token que o robô UiPath envia no cabeçalho x-robo-token. Gere um aleatório:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ROBO_TOKEN=

# Token da equipe de triagem (cabeçalho x-operador-token), gerado do mesmo jeito.
OPERADOR_TOKEN=

# Portal de demonstração da fila de manutenção (alvo do robô). Sem os dois, o portal fica desativado.
PORTAL_DEMO_USUARIO=
PORTAL_DEMO_SENHA=
